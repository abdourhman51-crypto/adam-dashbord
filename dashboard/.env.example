# Copy to .env.local for local runs. Never commit real values.

# Token for the Supabase edge function noor-dashboard (project adam-noor-inbox).
# Only its SHA-256 is stored in the function, so the token itself lives here and in Vercel.
NOOR_DASH_TOKEN=

# Optional: if set, the dashboard asks for this password (user: adam).
# Vercel login already protects *.vercel.app; this matters once a custom domain is added.
DASHBOARD_PASSWORD=
