# نسخة مرجعية لمتغيرات البيئة — انسخها إلى .env.local واملأ القيم
# .env.local مُستبعَد من Git عمداً، فلا تُضِف إليه أي مفتاح ثم تُرسله.
#
# Reference copy of the environment variables. Copy to .env.local and fill in.
# .env.local is deliberately gitignored — never commit real keys.

# رابط مشروع Supabase — عام
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co

# مفتاح anon — عام بحكم التصميم، ويُشحَن داخل حزمة المتصفح.
# ملاحظة: صلاحية القراءة المجهولة لكل بيانات الأهل والأطفال أُلغيت في Week-0،
# لذلك هذا المفتاح وحده لا يكفي لتشغيل اللوحة.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# مفتاح service_role — سرّي. على الخادم فقط، ولا يصل إلى المتصفح أبداً.
# اللوحة تُصيَّر على الخادم بالكامل، لذا استخدامه هنا آمن.
# هذا هو المفتاح الذي يجب أن تقرأ به اللوحة بعد Week-0.
SUPABASE_SERVICE_ROLE_KEY=
